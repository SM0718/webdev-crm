{
  "name": "webdev-crm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lead CRM backend for a web development agency (MERN)",
  "main": "src/index.js",
  "scripts": {
    "build": "pnpm install --frozen-lockfile && node scripts/build.js",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "clear-leads": "node scripts/clear-leads.js",
    "migrate-username": "node scripts/migrate-email-to-username.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
