# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- MongoDB Atlas ----
# Set MONGODB_URI and the server will use Atlas. It is assembled into:
#   <MONGODB_URI>/<MONGODB_DB>?retryWrites=true&w=majority
# with MONGODB_USERNAME / MONGODB_PASSWORD injected when the URI has no credentials.
MONGODB_URI=mongodb+srv://cluster0.xxxxx.mongodb.net
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_DB=webdev-crm

# ---- MongoDB fallback ----
# Used only when MONGODB_URI is not set. Point it at a local mongod:
#   mongodb://127.0.0.1:27017/webdev-crm
MONGO_URI=mongodb://127.0.0.1:27017/webdev-crm

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Sole Admin (auto-seeded on first boot) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_123
