# Vite dev-server proxy target for the Express API (no trailing slash).
# Development only — ignored once the app is built.
VITE_PROXY_TARGET=http://localhost:5000

# Base URL used by axios in the browser.
#
# Development: leave as /api so requests go through the Vite dev proxy
# above. The browser only ever talks to localhost:5173, so CORS never
# comes into play.
#
# Production: set this to the deployed API origin, including the /api
# prefix. Vite inlines import.meta.env at BUILD time, so this variable
# must be present in the environment where `vite build` runs — setting
# it on the host afterwards has no effect.
VITE_API_URL=/api
# VITE_API_URL=https://webdev-crm.onrender.com/api
